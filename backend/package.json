{
  "name": "dbsynchro-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DBSynchro API: bidirectional Google Sheets and PostgreSQL synchronization",
  "author": "Tapaswi Vemuru",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed-demo": "tsx src/db/seed-demo.ts"
  },
  "dependencies": {
    "@googleapis/drive": "^26.0.2",
    "@googleapis/sheets": "^18.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
