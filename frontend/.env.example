# ─── DBSynchro web app configuration ───────────────────────────────────────
# Only PUBLIC values belong here: everything prefixed VITE_ is shipped to the browser.

# URL of the DBSynchro API (no trailing slash)
VITE_API_BASE_URL=http://localhost:4000

# Supabase project (Project Settings → API). The anon key is public by design.
# Leave both empty to use local development mode (no real sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
