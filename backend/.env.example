# ─── DBSynchro API configuration ────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL of this API (used to build the Google OAuth redirect URI)
API_BASE_URL=http://localhost:4000
# URL of the frontend (CORS + post-OAuth redirect)
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins, comma separated (e.g. Vercel preview URLs)
CORS_ORIGINS=

# Metadata database (Supabase Postgres in production).
# Supabase: Project Settings → Database → Connection string (use the session pooler, port 5432).
DATABASE_URL=postgres:postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to true when the metadata database requires SSL (Supabase does)
DATABASE_SSL=false

# Authentication. Leave SUPABASE_URL empty to use local development mode (no real sign-in).
# AUTH_MODE=supabase|dev  (defaults to supabase when SUPABASE_URL is set; dev is refused in production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Not required by the API today; keep it server-side only if you add admin features.
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy projects using the shared HS256 JWT secret. Leave empty to verify with the project's JWKS.
SUPABASE_JWT_SECRET=

# Google OAuth client (Web application) used to connect Google Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${API_BASE_URL}/api/google/callback; must match the Google Cloud console exactly
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback

# 32 random bytes, base64 or hex. Encrypts database passwords and Google tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Changing it makes stored secrets unreadable.
ENCRYPTION_KEY=

# Allow user connections to private/loopback addresses (defaults to true outside production)
ALLOW_PRIVATE_DB_HOSTS=
# Run scheduled syncs in this process (run only one instance with this enabled)
ENABLE_SCHEDULER=true
MAX_SYNC_ROWS=20000
DEGRADED_LATENCY_MS=750
